--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -28,6 +28,7 @@
 #include "winternl.h"
 #include "wow64_private.h"
 #include "wine/debug.h"
+#include "wine/exception.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL( wow );
 
@@ -712,5 +712,50 @@ NTSTATUS WINAPI wow64_NtRaiseHardError( UINT *args )
     HARDERROR_RESPONSE *response = get_ptr( &args );
 
     FIXME( "%08lx %lu %lx %p %u %p: stub\n", status, count, params_mask, params, option, response );
+    /* DIAGNOSTIC (temporary): dump hard-error parameters so the message text */
+    /* is visible in the log instead of being swallowed by the stub. Remove   */
+    /* once the Ubisoft Connect failure is understood. */
+    if (params && count <= 8)
+    {
+        ULONG i;
+        for (i = 0; i < count; i++)
+            ERR( "hard-error raw param[%lu]=%08lx maskbit=%d\n",
+                 i, params[i], (params_mask & (1u << i)) ? 1 : 0 );
+        __TRY
+        {
+            for (i = 0; i < count; i++)
+            {
+                if (params_mask & (1u << i))
+                {
+                    if (params[i] < 0x10000)
+                    {
+                        ERR( "hard-error string[%lu]=<invalid ptr %08lx>\n", i, params[i] );
+                        continue;
+                    }
+                    {
+                        const UNICODE_STRING32 *us32 = ULongToPtr( params[i] );
+                        UNICODE_STRING us;
+                        UNICODE_STRING *us64 = unicode_str_32to64( &us, us32 );
+                        if (us64 && us64->Buffer && us64->Length)
+                        {
+                            char buf[65];
+                            ULONG k, len = us64->Length / sizeof(WCHAR);
+                            if (len > 64) len = 64;
+                            for (k = 0; k < len; k++)
+                            {
+                                WCHAR c = us64->Buffer[k];
+                                buf[k] = (c >= 0x20 && c < 0x7f) ? (char)c : '?';
+                            }
+                            buf[len] = 0;
+                            ERR( "hard-error string[%lu]=%s\n", i, buf );
+                        }
+                        else
+                            ERR( "hard-error string[%lu]=<null>\n", i );
+                    }
+                }
+            }
+        }
+        __EXCEPT_PAGE_FAULT { ERR( "hard-error string dump faulted\n" ); } __ENDTRY
+    }
     return STATUS_NOT_IMPLEMENTED;
 }
