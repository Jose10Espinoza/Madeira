--- a/dlls/wow64/system.c
+++ b/dlls/wow64/system.c
@@ -712,6 +712,32 @@ NTSTATUS WINAPI wow64_NtRaiseHardError( UINT *args )
     HARDERROR_RESPONSE *response = get_ptr( &args );
 
     FIXME( "%08lx %lu %lx %p %u %p: stub\n", status, count, params_mask, params, option, response );
+    /* DIAGNOSTIC (temporary): dump hard-error parameters so the message text
+     * is visible in the log instead of being swallowed by the stub.
+     * Remove once the Ubisoft Connect failure is understood. */
+    if (params && count <= 8)
+    {
+        ULONG i;
+        /* Log raw values first, before any dereference, so we still get
+         * numbers even if a dereference faults. */
+        for (i = 0; i < count; i++)
+            ERR( "hard-error raw param[%lu]=%08lx maskbit=%d\n",
+                 i, params[i], (params_mask & (1u << i)) ? 1 : 0 );
+        for (i = 0; i < count; i++)
+        {
+            if (params_mask & (1u << i))
+            {
+                /* Skip null and obviously-invalid low addresses. */
+                if (params[i] < 0x10000)
+                {
+                    ERR( "hard-error string[%lu]=<invalid ptr %08lx>\n", i, params[i] );
+                    continue;
+                }
+                {
+                    const UNICODE_STRING32 *us32 = ULongToPtr( params[i] );
+                    UNICODE_STRING us;
+                    ERR( "hard-error string[%lu]=%s\n", i,
+                         debugstr_us( unicode_str_32to64( &us, us32 ) ) );
+                }
+            }
+        }
+    }
     return STATUS_NOT_IMPLEMENTED;
 }
